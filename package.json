{
  "name": "dsh-plugin-agents-loader",
  "description": "Auto-discover and load ~/.agents/mcp.json MCP servers (http + stdio), ~/.agents/commands/ slash commands, and ~/.agents/AGENTS.md into dsh",
  "version": "0.2.0",
  "type": "module",
  "main": "src/entry.js",
  "exports": {
    ".": "./src/entry.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src/",
    "locale/",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrazyPigHead/dsh-plugin-agents-loader.git"
  },
  "bugs": {
    "url": "https://github.com/CrazyPigHead/dsh-plugin-agents-loader/issues"
  },
  "homepage": "https://github.com/CrazyPigHead/dsh-plugin-agents-loader#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "slash-commands",
    "agents"
  ],
  "author": "CrazyPigHead",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-mcp-client": "0.1.7-rc.2"
  },
  "license": "MIT"
}
